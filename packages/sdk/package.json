{
  "name": "@openpulse/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for the OpenPulse gateway",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@openpulse/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "openpulse",
    "ai",
    "agent",
    "sdk",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/steventa2024-lgtm/openpulse.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@openpulse/gateway": "workspace:*"
  }
}
